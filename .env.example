# Paystack — public key only (safe for the browser)
# Add in Vercel: Project Settings → Environment Variables
# Name: VITE_PAYSTACK_PUBLIC_KEY
# Value: your pk_live_... key from https://dashboard.paystack.com/#/settings/developer
#
# Do NOT add your secret key here. Secret keys belong only in server-side env vars
# if you later add payment webhooks (never expose sk_live_ in the frontend).
VITE_PAYSTACK_PUBLIC_KEY=
